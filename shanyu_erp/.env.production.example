# Runtime mode. Test uses an IP over HTTP; production uses a domain over HTTPS.
CADDY_SITE_ADDRESS=:80
WEB_ORIGIN=http://203.0.113.10
SESSION_COOKIE_SECURE=false

# Backup environment boundary. Test must remain local-only. Production must use
# SHANYU_DEPLOYMENT_ENVIRONMENT=production and SHANYU_BACKUP_MODE=cos.
SHANYU_DEPLOYMENT_ENVIRONMENT=test
SHANYU_BACKUP_MODE=local
SHANYU_COSCLI_PATH=/usr/local/bin/coscli
SHANYU_COS_CONFIG_PATH=/etc/shanyu-erp/cos.yaml
SHANYU_COS_BUCKET_ALIAS=shanyu-backup
SHANYU_COS_BACKUP_PREFIX=shanyu-erp/production/postgresql

# Immutable application images. Replace with the exact release tag or digest.
API_IMAGE=ghcr.io/example/shanyu-erp-api:v1.0.0
WEB_IMAGE=ghcr.io/example/shanyu-erp-web:v1.0.0
CADDY_IMAGE=caddy:2-alpine
POSTGRES_IMAGE=postgres:18-alpine

# Database secrets. Never commit the real values.
POSTGRES_DB=shanyu_erp
POSTGRES_USER=shanyu
POSTGRES_PASSWORD=replace-with-a-strong-random-password

# Initial administrator. Used only when the database has no ADMIN account.
# The fixed bootstrap password below is an explicitly accepted deployment exception;
# reset the ADMIN password in User & Permissions after first-environment acceptance.
ADMIN_ACCOUNT=admin
ADMIN_DISPLAY_NAME=系统管理员
ADMIN_INITIAL_PASSWORD=Shanyu123!

# Optional object-storage profile; V1 test deployment leaves it disabled.
MINIO_IMAGE=quay.io/minio/minio
MINIO_ROOT_USER=replace-with-a-random-admin-name
MINIO_ROOT_PASSWORD=replace-with-a-strong-random-password
